{
  "name": "@llmgates_api/pi-llmgates-provider",
  "version": "0.2.8",
  "description": "Pi provider extension for LLMGates: dynamic models from /v1/models and /login setup",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "llmgates",
    "tps"
  ],
  "license": "MIT",
  "author": "llmgates_api",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ax128/pi-llmgates.git"
  },
  "homepage": "https://github.com/ax128/pi-llmgates#readme",
  "bugs": {
    "url": "https://github.com/ax128/pi-llmgates/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm run test",
    "prepack": "npm run build",
    "gate": "bash ./scripts/pre-publish-gate.sh",
    "gate:record": "bash ./scripts/gate-record-pass.sh",
    "prepublishOnly": "npm run check",
    "publish:npm": "bash ./scripts/publish-npm.sh"
  },
  "pi": {
    "extensions": [
      "./dist/index.js",
      "./dist/tps.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.81.0 <0.82.0",
    "@earendil-works/pi-coding-agent": ">=0.81.0 <0.82.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.81.1",
    "@earendil-works/pi-coding-agent": "0.81.1",
    "@types/node": "^22.15.21",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "dependencies": {
    "proper-lockfile": "4.1.2"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
